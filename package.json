{
  "name": "aijiaoyu-app",
  "version": "1.0.0",
  "description": "AI教育应用 - 智能试卷分析与个性化学习方案",
  "private": true,
  "scripts": {
    "backend": "cd backend && npm run dev",
    "mobile": "cd mobile && npm start",
    "mobile:web": "cd mobile && npm run web",
    "dev": "concurrently \"npm run backend\" \"npm run mobile\"",
    "dev:web": "concurrently \"npm run backend\" \"npm run mobile:web\"",
    "install:all": "cd backend && npm install && cd ../mobile && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "author": "",
  "license": "MIT"
}
